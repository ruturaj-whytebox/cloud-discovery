# ---- Required ----

# AWS region used for API calls and resource discovery.
# Example: ap-south-1 (Mumbai), us-east-1 (N. Virginia).
AWS_REGION=ap-south-1

# Access key ID of the IAM user/identity that calls AWS.
AWS_ACCESS_KEY_ID=

# Secret access key that belongs to AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=


# ---- Optional ----

# Session token, only for temporary STS credentials.
# Leave empty when using a normal IAM user's access key.
AWS_SESSION_TOKEN=

# Cross-account role to assume (the real CYBRX integration model).
# Leave empty to test the base identity only.
AWS_ROLE_ARN=

# External ID configured in the role's trust policy. Required when AWS_ROLE_ARN is set.
AWS_EXTERNAL_ID=
